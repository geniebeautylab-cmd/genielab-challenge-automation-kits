#!/bin/bash
# run.sh — 네이버 블로그 최신글 → 카드뉴스 PNG 자동 생성 파이프라인
#   1) fetch.js   최신글 감지 + 본문 추출 (새 글 없으면 종료)
#   2) claude -p  본문 → 카드 문구 JSON
#   3) render.js  JSON → PNG
#   4) commit.js  state 갱신 + macOS 알림 + 결과 폴더 열기
#
# 옵션: --force  중복 여부와 관계없이 최신글을 다시 처리(테스트용)

# launchd 환경에서도 node/claude 를 찾도록 PATH 보강
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

FORCE=""
[ "$1" = "--force" ] && FORCE="--force"

mkdir -p "$ROOT/logs"
LOG="$ROOT/logs/run-$(date +%Y-%m-%d).log"
exec > >(tee -a "$LOG") 2>&1
echo "=================================================="
echo "[run] 시작 $(date '+%Y-%m-%d %H:%M:%S')  FORCE=${FORCE:-no}"

# --- 1) 최신글 감지 ---
# 우선 블로그 앱(nailblog)이 저장한 발행글을 직접 읽는다(비공개 발행·RSS 지연에 강함).
# 실패(ERROR)하면 기존 RSS 방식으로 폴백한다.
SIGNAL="$(node scripts/fetch-local.js $FORCE)"
echo "[run] fetch-local 결과: $SIGNAL"
if [ "$SIGNAL" = "ERROR" ]; then
  echo "[run] 로컬(블로그앱) 조회 실패 → RSS 폴백"
  SIGNAL="$(node scripts/fetch.js $FORCE)"
  echo "[run] fetch(RSS) 결과: $SIGNAL"
fi
case "$SIGNAL" in
  NEW) ;;
  NONE) echo "[run] 새 글 없음. 종료."; exit 0 ;;
  *) echo "[run] fetch 오류로 중단."; exit 1 ;;
esac

# --- 2) 카드 문구 작성 (claude -p, stdin 으로 지시+원문 전달) ---
TITLE="$(node -e 'console.log(JSON.parse(require("fs").readFileSync(".cache/post.json","utf8")).title||"")')"
echo "[run] 문구 작성 중: $TITLE"
{
  cat slides-prompt.md
  echo
  node -e 'console.log(JSON.parse(require("fs").readFileSync(".cache/post.json","utf8")).text||"")'
} | claude -p "위 지시사항과 블로그 원문을 읽고, 요구한 JSON 객체 하나만 출력하세요. 코드펜스나 설명 없이 순수 JSON 만." \
  | node scripts/parse-slides.js

if [ ! -f ".cache/slides.json" ]; then
  echo "[run] slides.json 생성 실패로 중단."; exit 1
fi

# --- 3) 렌더링 ---
OUTDIR="$(node scripts/render.js .cache/slides.json)"
RENDER_RC=$?
if [ $RENDER_RC -ne 0 ] || [ -z "$OUTDIR" ]; then
  echo "[run] 렌더링 실패로 중단."; exit 1
fi
echo "[run] 이미지 생성 완료: $OUTDIR"

# --- 4) state 갱신 + 알림 + 폴더 열기 ---
node scripts/commit.js
COUNT="$(ls "$OUTDIR"/*.png 2>/dev/null | wc -l | tr -d ' ')"
osascript -e "display notification \"카드뉴스 ${COUNT}장 생성됨 · 검토 후 인스타 업로드\" with title \"카드뉴스 준비 완료\" subtitle \"$TITLE\" sound name \"Glass\"" 2>/dev/null
open "$OUTDIR" 2>/dev/null

# --- 5) 텔레그램으로 카드 전송(설정돼 있으면) ---
node scripts/send-telegram.js "$OUTDIR" || echo "[run] 텔레그램 전송 건너뜀/실패(설정 확인)"

echo "[run] 완료 $(date '+%H:%M:%S')"
