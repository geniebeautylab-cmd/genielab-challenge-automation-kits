# ── AI 인증 (구독 요금제) ────────────────────────────────
# 터미널에서 `claude setup-token` 실행 → 나온 토큰을 아래에 붙여넣기
CLAUDE_CODE_OAUTH_TOKEN=

# ⚠️ ANTHROPIC_API_KEY 는 절대 넣지 마세요.
#    같이 설정되면 API 키가 우선되어 구독이 무시되고 별도 과금됩니다.

# ── 이미지 검색 (무료 라이선스) ──────────────────────────
# https://www.pexels.com/api/ 에서 무료 발급 (1분)
PEXELS_API_KEY=

# ── 서버 ────────────────────────────────────────────────
PORT=3000

# ── 네이버 블로그 ───────────────────────────────────────
# 블로그 주소가 blog.naver.com/mynailshop 이면 mynailshop
NAVER_BLOG_ID=
